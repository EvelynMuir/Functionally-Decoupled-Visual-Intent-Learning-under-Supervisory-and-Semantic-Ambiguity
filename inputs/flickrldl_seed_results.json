{
  "dataset": "flickrldl",
  "protocol": {
    "selection_metric": "validation KL (lower is better)",
    "test_split": "official split 1; never used for model selection",
    "seeds": [
      2026,
      2027,
      2028,
      2029,
      2030
    ],
    "slr_topk": 5,
    "slr_alpha": 0.3,
    "slrc_description_file": "${DATA_ROOT}/LDL/processed/semantic_priors/ldl_gemini_slrc_prior.json",
    "utd_gate": "1-max(y), where max(y) is sample-level annotator agreement; training only",
    "teacher": "3-fold OOF VLM-rationale text teacher, training only",
    "reported_metrics": {
      "lower_is_better": [
        "chebyshev",
        "clark",
        "kl",
        "dvse"
      ],
      "higher_is_better": [
        "cosine",
        "spearman",
        "mu"
      ],
      "mu_unit": "percent",
      "dvse_polarity": {
        "positive": [
          "amusement",
          "contentment",
          "excitement"
        ],
        "negative": [
          "anger",
          "disgust",
          "fear",
          "sadness"
        ],
        "excluded": [
          "awe"
        ]
      }
    }
  },
